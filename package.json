{
  "name": "bodymetrics",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "vercel-build": "tsx prisma/pre-push.ts && prisma db push --skip-generate && prisma db seed && next build",
    "db:up": "docker compose up -d db",
    "db:push": "tsx prisma/pre-push.ts && prisma db push",
    "db:seed": "prisma db seed",
    "setup": "tsx prisma/pre-push.ts && prisma db push && prisma db seed",
    "user:set": "tsx prisma/user.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@prisma/client": "^6.16.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^6.2.14",
    "lucide-react": "^1.64.0",
    "mcp-handler": "^2.3.0",
    "next": "^15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.2.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.28",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
