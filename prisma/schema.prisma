// BodyMetrics data model. Postgres (Neon in production, Docker locally).
// Multi-user: every row of personal data belongs to a User; admins manage users and can view their data.
// Apply changes with `npm run db:push` (runs prisma/pre-push.ts first, no migration files).
// Dates that represent a "day" are stored as local "YYYY-MM-DD" strings (see src/lib/dates.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's pooled URL can't run schema pushes; the unpooled one is used for those.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Login account. The first one comes from AUTH_USERNAME / AUTH_PASSWORD and is an admin;
// admins create the others in /admin, or use `npm run user:set`.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String   @default("")
  role         String   @default("user") // admin | user
  active       Boolean  @default(true) // inactive users cannot sign in
  passwordHash String // scrypt, see src/lib/auth/password.ts
  // Bumped on password change or deactivation; sessions carrying an older value are rejected.
  sessionVer   Int      @default(1)
  // Set when an admin creates the account or resets its password: the user must pick their own
  // password before using the app.
  mustChangePassword Boolean @default(false)
  createdAt    DateTime @default(now())

  profile              Profile?
  bodyLogs             BodyLog[]
  photos               Photo[]
  images               ImageBlob[]
  meals                Meal[]
  workouts             Workout[]
  exercises            Exercise[]
  weeklyReports        WeeklyReport[]
  oauthCodes           OAuthCode[]
  oauthTokens          OAuthToken[]
  ownedMcpGroups       McpConnectionGroup[]       @relation("McpGroupOwner")
  mcpGroupMemberships McpConnectionGroupMember[]
}

// Photo bytes (WebP), kept in the database so the app needs no disk.
model ImageBlob {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mime      String   @default("image/webp")
  data      Bytes
  createdAt DateTime @default(now())

  @@index([userId])
}

// One per user, created on first use.
model Profile {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String   @default("")
  sex            String   @default("male") // male | female
  birthYear      Int      @default(1995)
  heightCm       Float    @default(170)
  // Multiplier on BMR for everyday movement only; logged workouts are added on top.
  activityFactor Float    @default(1.2)
  // Legacy: start weight now comes from the first body log; read only as a fallback for old data.
  startWeightKg  Float?
  goalWeightKg   Float?
  dailyDeficit   Int      @default(500)
  proteinPerKg   Float    @default(1.8)
  // Set when the /onboarding wizard is finished; until then the values above are defaults, not the user's.
  onboardedAt    DateTime?
  updatedAt      DateTime @updatedAt
}

model BodyLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       String
  weightKg   Float?
  waistCm    Float?
  bodyFatPct Float?
  note       String?
  createdAt  DateTime @default(now())
  photos     Photo[]

  @@index([userId, date])
}

model Photo {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // food | body
  path      String // ImageBlob id, served at /api/uploads/<path>
  width     Int
  height    Int
  date      String
  takenAt   DateTime @default(now())
  mealId    String?
  meal      Meal?    @relation(fields: [mealId], references: [id], onDelete: SetNull)
  bodyLogId String?
  bodyLog   BodyLog? @relation(fields: [bodyLogId], references: [id], onDelete: SetNull)

  @@index([userId, date, kind])
}

model Meal {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  type      String // breakfast | lunch | dinner | snack
  eatenAt   DateTime   @default(now())
  note      String?
  aiRaw     String? // raw JSON returned by the photo analysis, kept for auditing
  createdAt DateTime   @default(now())
  items     MealItem[]
  photos    Photo[]

  @@index([userId, date])
}

model MealItem {
  id         String  @id @default(cuid())
  mealId     String
  meal       Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade)
  name       String
  portionG   Float?
  kcal       Float
  proteinG   Float   @default(0)
  carbG      Float   @default(0)
  fatG       Float   @default(0)
  source     String  @default("manual") // manual | ai
  confidence Float? // 0..1, AI only
}

// userId null = shared library (seeded); otherwise a user's own custom exercise.
model Exercise {
  id          String         @id @default(cuid())
  userId      String?
  user        User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  category    String // strength | cardio | hiit | other
  met         Float
  muscleGroup String?
  entries     WorkoutEntry[]

  @@index([userId, name])
}

model Workout {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         String
  startedAt    DateTime       @default(now())
  durationMin  Int
  note         String?
  // Set when a smartwatch gives a better number; replaces the MET estimate.
  kcalOverride Float?
  createdAt    DateTime       @default(now())
  entries      WorkoutEntry[]

  @@index([userId, date])
}

model WorkoutEntry {
  id          String       @id @default(cuid())
  workoutId   String
  workout     Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise     @relation(fields: [exerciseId], references: [id])
  order       Int          @default(0)
  durationMin Float // active minutes used for the MET estimate
  intensity   String       @default("moderate") // light | moderate | vigorous
  distanceKm  Float?
  kcal        Float // net kcal, computed with exerciseKcal() at save time
  sets        WorkoutSet[]
}

model WorkoutSet {
  id       String       @id @default(cuid())
  entryId  String
  entry    WorkoutEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  setNo    Int
  reps     Int?
  weightKg Float?
}

model WeeklyReport {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart String // Monday, YYYY-MM-DD
  stats     String // JSON snapshot of the numbers the report was written from
  content   String // JSON written by the AI
  createdAt DateTime @default(now())

  @@unique([userId, weekStart])
}

// ---- OAuth 2.1 for the claude.ai connector (src/lib/oauth) ----
// Codes and tokens are stored only as SHA-256 hashes (hex) in `id`.
// Codes and tokens belong to a User and are deleted with it.

// A connector app. Dynamically registered clients get a random id; Client ID Metadata
// Document clients use their https URL as id (row kept only for the name shown on /profile).
model OAuthClient {
  id           String   @id
  name         String   @default("")
  redirectUris String[]
  createdAt    DateTime @default(now())
}

// A shared Claude connector can access only profiles whose owners explicitly joined this group.
// The OAuth token is group-scoped; every MCP tool still requires a member profile selection.
model McpConnectionGroup {
  id           String                     @id @default(cuid())
  name         String                     @default("BodyMetrics")
  ownerUserId  String
  owner        User                       @relation("McpGroupOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  joinCodeHash String                     @unique
  createdAt    DateTime                   @default(now())
  members      McpConnectionGroupMember[]
  oauthCodes   OAuthCode[]
  oauthTokens  OAuthToken[]

  @@index([ownerUserId])
}

model McpConnectionGroupMember {
  groupId  String
  group    McpConnectionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime           @default(now())

  @@id([groupId, userId])
  @@index([userId])
}

// Authorization code: single use, ~10 minutes, PKCE S256 required.
model OAuthCode {
  id                String              @id // sha256(code)
  clientId          String
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionGroupId String?
  connectionGroup   McpConnectionGroup? @relation(fields: [connectionGroupId], references: [id], onDelete: Cascade)
  redirectUri       String
  codeChallenge     String // base64url(sha256(code_verifier))
  scope             String              @default("")
  resource          String?
  expiresAt         DateTime
  usedAt            DateTime?
  createdAt         DateTime            @default(now())

  @@index([userId])
}

// Access (1 h) and refresh (30 days, rotated on use) tokens. All tokens descending from one
// authorization share `familyId`; reusing a rotated refresh token revokes the whole family.
model OAuthToken {
  id                String              @id // sha256(token)
  kind              String // access | refresh
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionGroupId String?
  connectionGroup   McpConnectionGroup? @relation(fields: [connectionGroupId], references: [id], onDelete: Cascade)
  clientId          String
  familyId          String
  scope             String              @default("")
  resource          String?
  expiresAt         DateTime
  usedAt            DateTime? // refresh tokens: when rotated
  revokedAt         DateTime?
  lastUsedAt        DateTime?
  createdAt         DateTime            @default(now())

  @@index([userId, clientId])
  @@index([familyId])
}
