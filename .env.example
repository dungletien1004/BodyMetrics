# Postgres. Locally: `npm run db:up` starts one in Docker with these credentials.
# On Vercel, the Neon integration sets both variables for you.
DATABASE_URL="postgresql://bodymetrics:bodymetrics@localhost:5433/bodymetrics"
DATABASE_URL_UNPOOLED="postgresql://bodymetrics:bodymetrics@localhost:5433/bodymetrics"

# Signs login cookies. Any random string of 32+ characters, e.g. `openssl rand -base64 48`.
AUTH_SECRET=""
# Account created on first login when the database has no user yet.
# Change the password later in Hồ sơ, or with `npm run user:set -- <username> <password>`.
AUTH_USERNAME="admin"
AUTH_PASSWORD=""

# Needed for food photo analysis and weekly reports inside the app.
ANTHROPIC_API_KEY=""

# Timezone for "today" and meal times (servers usually run in UTC).
APP_TIMEZONE="Asia/Ho_Chi_Minh"
