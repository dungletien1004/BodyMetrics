DATABASE_URL="file:./dev.db"
UPLOAD_DIR="./uploads"

# Signs login cookies. Any random string of 32+ characters, e.g. `openssl rand -base64 48`.
AUTH_SECRET=""
# Account created on first login when the database has no user yet.
# Change the password later in Hồ sơ, or with `npm run user:set -- <username> <password>`.
AUTH_USERNAME="admin"
AUTH_PASSWORD=""

# Needed for food photo analysis and weekly reports inside the app.
ANTHROPIC_API_KEY=""

# Secret path segment for the claude.ai connector: https://<host>/api/mcp/<MCP_TOKEN>
# 24+ random characters, e.g. `openssl rand -base64 30`. Leave empty to disable the connector.
MCP_TOKEN=""
